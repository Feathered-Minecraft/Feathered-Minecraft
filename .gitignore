# Rust build output (also covers temporary screenshots, debug artifacts and
# local upstream clones kept under target/, e.g. target/noble-upstream/)
/target

# Compiled resource-pack cache (generated by `feathered compile-pack`)
*.feathered.bin
feathered-cache.bin

# Feathered's local data directory (runtime settings, imported pack copies)
/data/

# Local copy of the extracted Minecraft resource pack.
# Assets are copyright Mojang/Microsoft and subject to the Minecraft EULA —
# they are not redistributed with this repository. Point --pack-dir at your
# own copy (see README).
/texture

# Third-party reference source kept for local consultation only
/pumpkin\ mc\ and\ steel\ mc\ src\ code

# Local clones of third-party shader packs (consulted read-only for
# research/validation; their sources are never committed — GPL-3.0 upstream)
/noble-upstream/
/noble/
/docs/research/

# Temporary screenshots and debug artifacts written to the repo root
/*.png

# Binaries and debug symbols that escape the build directory
*.exe
*.dll
*.so
*.dylib
*.pdb
*.bin.log

# Logs and scratch files
*.log
*.tmp

# Machine-specific / environment files
.env
.env.*
!.env.example
.DS_Store

# Editor / OS noise
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# Local agent/tooling state
.freebuff/
